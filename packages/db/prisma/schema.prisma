// Esquema compartido por el bot (discord.js) y la web (Next.js).
// Prisma 7: la URL de conexión NO va aquí, va en prisma.config.ts.
// Montos en CLP como BigInt (pesos enteros, sin decimales).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── ENUMS ─────────────────────────

enum RolPlataforma {
  JUGADOR
  STAFF
  ADMIN
}

enum EstadoVerificacion {
  PENDIENTE
  VERIFICADO
  RECHAZADO
  SUSPENDIDO
}

enum EstadoDocumento {
  VIGENTE
  VENCIDO
  SUSPENDIDO
  REVOCADO
}

enum TipoDocumento {
  LICENCIA_CONDUCIR
  PORTE_ARMA
  PASAPORTE
  CERTIFICADO_ANTECEDENTES
  OTRO
}

enum TipoInstitucion {
  GOBIERNO
  MUNICIPAL
  JUDICIAL
  FISCALIA
  DEFENSORIA
  POLICIAL
  SALUD
  BANCARIA
  OTRA
}

enum TipoCuenta {
  CORRIENTE
  VISTA
  AHORRO
  EMPRESA
}

enum EstadoCuenta {
  ACTIVA
  CONGELADA
  CERRADA
}

enum TipoTransaccion {
  TRANSFERENCIA
  DEPOSITO
  RETIRO
  PAGO_MULTA
  SUELDO
  AJUSTE
}

enum TipoCaso {
  PENAL
  CIVIL
  FAMILIA
  ADMINISTRATIVO
}

enum EstadoCaso {
  ABIERTO
  EN_INVESTIGACION
  EN_JUICIO
  CERRADO
  ARCHIVADO
}

enum RolCaso {
  IMPUTADO
  VICTIMA
  TESTIGO
  QUERELLANTE
  FISCAL
  DEFENSOR
  JUEZ
}

enum EstadoMulta {
  PENDIENTE
  PAGADA
  ANULADA
}

enum CategoriaTicket {
  SOPORTE
  REPORTE
  APELACION
  OTRO
}

enum EstadoTicket {
  ABIERTO
  EN_ATENCION
  CERRADO
}

enum PrioridadTicket {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EquipoTicket {
  FUNDACION
  JUNTA_ADMINISTRATIVA
  MODERACION
  SOPORTE
}

enum TipoActuacionTicket {
  APERTURA
  DERIVACION
  REASIGNACION
  CIERRE
}

enum ResultadoActuacionTicket {
  EXITOSA
  FALLIDA
  REVERTIDA
}

enum TipoExpedienteAdministrativo {
  PETICION
  RECLAMO
  RECURSO
  DENUNCIA
  CONSULTA
  OTRO
}

enum EstadoExpedienteAdministrativo {
  RECIBIDO
  EN_REVISION
  EN_TRAMITACION
  RESUELTO
  ARCHIVADO
}

enum TipoActuacionAdministrativa {
  RECEPCION
  NOTA
  CAMBIO_ESTADO
  REAPERTURA
  RESOLUCION
  ARCHIVO
}

enum ResultadoResolucionAdministrativa {
  ACOGIDA
  PARCIAL
  RECHAZADA
  INADMISIBLE
}

enum TipoPostulacion {
  WHITELIST
  INSTITUCION
  STAFF
}

enum EstadoPostulacion {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

// ───────────────── USUARIOS Y VERIFICACIÓN ─────────────────

model Usuario {
  id                  String             @id @default(cuid())
  discordId           String             @unique
  username            String
  avatar              String?
  rol                 RolPlataforma      @default(JUGADOR)
  verificacion        EstadoVerificacion @default(PENDIENTE)
  verificadoEn        DateTime?
  verificadoPorId     String?
  verificadoPor       Usuario?           @relation("Verificaciones", fields: [verificadoPorId], references: [id])
  verificados         Usuario[]          @relation("Verificaciones")
  bienvenidaEventoKey String?
  creadoEn            DateTime           @default(now())
  actualizadoEn       DateTime           @updatedAt

  personajes             Personaje[]
  ticketsCreados         Ticket[]      @relation("TicketsCreados")
  ticketsAsignados       Ticket[]      @relation("TicketsAsignados")
  postulaciones          Postulacion[] @relation("PostulacionesEnviadas")
  postulacionesRevisadas Postulacion[] @relation("PostulacionesRevisadas")
  casosCreados           Caso[]
  expedientesSolicitados ExpedienteAdministrativo[] @relation("ExpedientesSolicitados")
  auditorias             Auditoria[]

  @@map("usuarios")
}

// ───────────────────── PERSONAJES Y DOCUMENTOS ─────────────────────

model Personaje {
  id                  String    @id @default(cuid())
  usuarioId           String
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombres             String
  apellidos           String
  rut                 String    @unique // RUT ficticio del RP, ej: 21.345.678-9
  fechaNacimiento     DateTime
  nacionalidad        String    @default("Chilena")
  activo              Boolean   @default(true)
  dinero              BigInt    @default(0)
  dineroSucio         BigInt    @default(0)
  diarioDisponibleEn  DateTime?
  trabajoDisponibleEn DateTime?
  crimenDisponibleEn  DateTime?
  lavadoDisponibleEn  DateTime?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  cedula          Cedula?
  documentos      Documento[]
  cuentas         CuentaBancaria[]
  cargos          Funcionario[]
  participaciones CasoParticipante[]
  multasRecibidas Multa[]              @relation("MultasRecibidas")
  multasEmitidas  Multa[]              @relation("MultasEmitidas")
  antecedentes    Antecedente[]
  inventario      InventarioItem[]
  vehiculos       Vehiculo[]
  movimientos     MovimientoEconomia[]

  @@index([usuarioId])
  @@map("personajes")
}

model Item {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  precio      BigInt   @default(0)
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  inventarios InventarioItem[]

  @@map("items")
}

model InventarioItem {
  id          String    @id @default(cuid())
  personajeId String
  personaje   Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cantidad    Int       @default(0)

  @@unique([personajeId, itemId])
  @@map("inventario_items")
}

model Vehiculo {
  id           String    @id @default(cuid())
  patente      String    @unique
  modelo       String
  color        String?
  personajeId  String
  personaje    Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  activo       Boolean   @default(true)
  registradoEn DateTime  @default(now())

  @@index([personajeId, activo])
  @@map("vehiculos")
}

model MovimientoEconomia {
  id          String    @id @default(cuid())
  personajeId String
  personaje   Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  tipo        String
  monto       BigInt
  descripcion String?
  creadoEn    DateTime  @default(now())

  @@index([personajeId, creadoEn])
  @@map("movimientos_economia")
}

model Cedula {
  id             String          @id @default(cuid())
  personajeId    String          @unique
  personaje      Personaje       @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  numeroSerie    String          @unique
  robloxUsername String?
  emitidaEn      DateTime        @default(now())
  venceEn        DateTime
  estado         EstadoDocumento @default(VIGENTE)

  @@map("cedulas")
}

model Documento {
  id          String          @id @default(cuid())
  personajeId String
  personaje   Personaje       @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  tipo        TipoDocumento
  numero      String          @unique
  detalle     Json? // ej: clase de licencia, modelo de arma
  emitidoEn   DateTime        @default(now())
  venceEn     DateTime?
  estado      EstadoDocumento @default(VIGENTE)

  @@index([personajeId, tipo])
  @@map("documentos")
}

// ───────────────────── INSTITUCIONES ─────────────────────

model Institucion {
  id            String          @id @default(cuid())
  nombre        String          @unique
  slug          String          @unique // para la URL del portal: /instituciones/fiscalia
  tipo          TipoInstitucion
  descripcion   String?
  discordRoleId String?
  activa        Boolean         @default(true)

  cargos        Cargo[]
  casos         Caso[]
  postulaciones Postulacion[]
  expedientes   ExpedienteAdministrativo[]
  autoridades   AutoridadAdministrativa[]

  @@map("instituciones")
}

model Cargo {
  id            String      @id @default(cuid())
  institucionId String
  institucion   Institucion @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  nombre        String
  nivel         Int         @default(0) // jerarquía: mayor número = mayor rango
  sueldo        BigInt      @default(0)
  permisos      String[] // ej: ["casos:crear", "multas:emitir"]
  discordRoleId String?

  funcionarios Funcionario[]

  @@unique([institucionId, nombre])
  @@map("cargos")
}

model Funcionario {
  id          String    @id @default(cuid())
  personajeId String
  personaje   Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  cargoId     String
  cargo       Cargo     @relation(fields: [cargoId], references: [id])
  desde       DateTime  @default(now())
  hasta       DateTime?
  activo      Boolean   @default(true)

  @@index([personajeId, activo])
  @@index([cargoId])
  @@map("funcionarios")
}

// ───────────────────── BANCO ─────────────────────

model CuentaBancaria {
  id          String       @id @default(cuid())
  personajeId String
  personaje   Personaje    @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  numero      String       @unique
  tipo        TipoCuenta   @default(VISTA)
  saldo       BigInt       @default(0)
  estado      EstadoCuenta @default(ACTIVA)
  creadaEn    DateTime     @default(now())

  salidas  Transaccion[] @relation("CuentaOrigen")
  entradas Transaccion[] @relation("CuentaDestino")

  @@index([personajeId])
  @@map("cuentas_bancarias")
}

model Transaccion {
  id        String          @id @default(cuid())
  tipo      TipoTransaccion
  monto     BigInt
  glosa     String?
  origenId  String? // null en depósitos/sueldos/ajustes
  origen    CuentaBancaria? @relation("CuentaOrigen", fields: [origenId], references: [id])
  destinoId String? // null en retiros
  destino   CuentaBancaria? @relation("CuentaDestino", fields: [destinoId], references: [id])
  creadaEn  DateTime        @default(now())

  multa Multa?

  @@index([origenId])
  @@index([destinoId])
  @@map("transacciones")
}

// ───────────────── CASOS, MULTAS Y ANTECEDENTES ─────────────────

model Caso {
  id            String       @id @default(cuid())
  codigo        String       @unique // RIT/RUC del caso, ej: 240108-2026
  titulo        String
  descripcion   String?      @db.Text
  tipo          TipoCaso     @default(PENAL)
  estado        EstadoCaso   @default(ABIERTO)
  institucionId String?
  institucion   Institucion? @relation(fields: [institucionId], references: [id])
  creadoPorId   String
  creadoPor     Usuario      @relation(fields: [creadoPorId], references: [id])
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  cerradoEn     DateTime?

  participantes CasoParticipante[]
  multas        Multa[]
  antecedentes  Antecedente[]

  @@index([estado])
  @@map("casos")
}

model CasoParticipante {
  id          String    @id @default(cuid())
  casoId      String
  caso        Caso      @relation(fields: [casoId], references: [id], onDelete: Cascade)
  personajeId String
  personaje   Personaje @relation(fields: [personajeId], references: [id])
  rol         RolCaso

  @@unique([casoId, personajeId, rol])
  @@index([personajeId])
  @@map("caso_participantes")
}

model Multa {
  id                String       @id @default(cuid())
  personajeId       String // quien recibe la multa
  personaje         Personaje    @relation("MultasRecibidas", fields: [personajeId], references: [id])
  emisorId          String // personaje funcionario que la cursa
  emisor            Personaje    @relation("MultasEmitidas", fields: [emisorId], references: [id])
  casoId            String?
  caso              Caso?        @relation(fields: [casoId], references: [id])
  motivo            String
  monto             BigInt
  estado            EstadoMulta  @default(PENDIENTE)
  emitidaEn         DateTime     @default(now())
  pagadaEn          DateTime?
  transaccionPagoId String?      @unique
  transaccionPago   Transaccion? @relation(fields: [transaccionPagoId], references: [id])

  @@index([personajeId, estado])
  @@map("multas")
}

model Antecedente {
  id           String    @id @default(cuid())
  personajeId  String
  personaje    Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  casoId       String?
  caso         Caso?     @relation(fields: [casoId], references: [id])
  descripcion  String
  vigente      Boolean   @default(true)
  registradoEn DateTime  @default(now())
  expiraEn     DateTime?

  @@index([personajeId, vigente])
  @@map("antecedentes")
}

// ───────────────── TICKETS Y POSTULACIONES ─────────────────

model Ticket {
  id             String          @id @default(cuid())
  numero         Int             @unique @default(autoincrement())
  categoria      CategoriaTicket @default(SOPORTE)
  asunto         String
  estado         EstadoTicket    @default(ABIERTO)
  prioridad      PrioridadTicket @default(MEDIA)
  equipoAsignado EquipoTicket?
  resumen        String?         @db.Text
  asignadoEn     DateTime?
  canalDiscordId String?         @unique
  usuarioId      String
  usuario        Usuario         @relation("TicketsCreados", fields: [usuarioId], references: [id])
  asignadoAId    String?
  asignadoA      Usuario?        @relation("TicketsAsignados", fields: [asignadoAId], references: [id])
  transcripcion  String?         @db.Text
  creadoEn       DateTime        @default(now())
  cerradoEn      DateTime?
  cerradoPorDiscordId String?
  actuaciones    TicketActuacion[]

  @@index([estado])
  @@index([equipoAsignado, estado])
  @@map("tickets")
}

model TicketActuacion {
  id                 String               @id @default(cuid())
  ticketId           String
  ticket             Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorDiscordId     String
  tipo               TipoActuacionTicket
  equipoAnterior     EquipoTicket?
  equipoNuevo        EquipoTicket?
  prioridadAnterior  PrioridadTicket?
  prioridadNueva     PrioridadTicket?
  resultado          ResultadoActuacionTicket @default(EXITOSA)
  motivo             String?                  @db.Text
  detalle            String?              @db.Text
  creadaEn           DateTime             @default(now())

  @@index([ticketId, creadaEn])
  @@map("actuaciones_ticket")
}

model SecuenciaExpedienteAdministrativo {
  anio      Int @id
  siguiente Int @default(0)

  @@map("secuencias_expediente_administrativo")
}

model ExpedienteAdministrativo {
  id             String                          @id @default(cuid())
  folio          String                          @unique
  guildId        String
  solicitanteId  String
  solicitante    Usuario                         @relation("ExpedientesSolicitados", fields: [solicitanteId], references: [id])
  tipo           TipoExpedienteAdministrativo
  institucionId  String?
  institucion    Institucion?                    @relation(fields: [institucionId], references: [id], onDelete: SetNull)
  asunto         String
  descripcion    String                          @db.Text
  estado         EstadoExpedienteAdministrativo  @default(RECIBIDO)
  creadoEn       DateTime                        @default(now())
  actualizadoEn  DateTime                        @updatedAt
  resueltoEn     DateTime?
  actuaciones    ActuacionAdministrativa[]
  resoluciones   ResolucionAdministrativa[]

  @@index([guildId, estado, creadoEn])
  @@index([solicitanteId, creadoEn])
  @@index([tipo, institucionId, estado])
  @@map("expedientes_administrativos")
}

model ActuacionAdministrativa {
  id            String                          @id @default(cuid())
  expedienteId  String
  expediente    ExpedienteAdministrativo        @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  actorDiscordId String
  tipo          TipoActuacionAdministrativa
  estadoAnterior EstadoExpedienteAdministrativo?
  estadoNuevo   EstadoExpedienteAdministrativo?
  contenido     String                          @db.Text
  creadaEn      DateTime                        @default(now())

  @@index([expedienteId, creadaEn])
  @@map("actuaciones_administrativas")
}

model ResolucionAdministrativa {
  id            String                            @id @default(cuid())
  expedienteId  String
  expediente    ExpedienteAdministrativo          @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  actorDiscordId String
  resultado     ResultadoResolucionAdministrativa
  decision      String                            @db.Text
  fundamento    String?                           @db.Text
  creadaEn      DateTime                          @default(now())

  @@index([expedienteId, creadaEn])
  @@map("resoluciones_administrativas")
}

model AutoridadAdministrativa {
  id            String                         @id @default(cuid())
  guildId       String
  tipo          TipoExpedienteAdministrativo
  alcance       String
  institucionId String?
  institucion   Institucion?                   @relation(fields: [institucionId], references: [id], onDelete: SetNull)
  rolDiscordId  String
  actualizadoEn DateTime                       @updatedAt

  @@unique([guildId, tipo, alcance])
  @@index([guildId, rolDiscordId])
  @@map("autoridades_administrativas")
}

model Postulacion {
  id            String            @id @default(cuid())
  tipo          TipoPostulacion
  usuarioId     String
  usuario       Usuario           @relation("PostulacionesEnviadas", fields: [usuarioId], references: [id])
  institucionId String?
  institucion   Institucion?      @relation(fields: [institucionId], references: [id])
  respuestas    Json // respuestas del formulario
  estado        EstadoPostulacion @default(PENDIENTE)
  revisorId     String?
  revisor       Usuario?          @relation("PostulacionesRevisadas", fields: [revisorId], references: [id])
  notas         String?
  creadaEn      DateTime          @default(now())
  revisadaEn    DateTime?

  @@index([estado, tipo])
  @@map("postulaciones")
}

// ───────────────────── AUDITORÍA ─────────────────────

model Auditoria {
  id        String   @id @default(cuid())
  actorId   String?
  actor     Usuario? @relation(fields: [actorId], references: [id])
  accion    String // ej: "multa.emitir", "cuenta.congelar"
  entidad   String // ej: "Multa"
  entidadId String?
  detalle   Json?
  creadaEn  DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([actorId])
  @@map("auditoria")
}

model ConfiguracionServidor {
  id            String   @id @default(cuid())
  clave         String   @unique
  valor         Json
  actualizadoEn DateTime @updatedAt

  @@map("configuracion_servidor")
}

model MemoriaIA {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  usuarioId      String
  mensajeUsuario String   @db.Text
  respuesta      String   @db.Text
  creadoEn       DateTime @default(now())

  @@index([guildId, channelId, usuarioId, creadoEn])
  @@index([creadoEn])
  @@map("memoria_ia")
}
