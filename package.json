{
  "name": "rp-chile",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run generate -w @rp-chile/db",
    "db:migrate": "npm run migrate -w @rp-chile/db",
    "db:studio": "npm run studio -w @rp-chile/db",
    "bot:dev": "npm run dev -w @rp-chile/bot",
    "bot:start": "npm run start -w @rp-chile/bot",
    "bot:deploy-commands": "npm run deploy-commands -w @rp-chile/bot",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@discordjs/opus@0.11.0": true,
    "ffmpeg-static@5.3.0": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "7.5.23"
    }
  },
  "dependencies": {
    "patch-package": "8.0.1"
  }
}
